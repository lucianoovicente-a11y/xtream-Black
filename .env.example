# Configurações de Ambiente XTREAM SERVER OPENSOURCE

# Modo Debug (true para desenvolvimento, false para produção)
DEBUG=true

# Configurações do Banco de Dados
DB_HOST=localhost
DB_NAME=qualidad_flixtv
DB_USER=qualidad_flixtv
DB_PASS=Ldkl@132004

# Configurações de API Externa
TMDB_API_KEY=sua_chave_aqui

# Mercado Pago
MP_SANDBOX=true
MP_ACCESS_TOKEN=seu_token_aqui
MP_WEBHOOK_SECRET=seu_secret_aqui

# Configurações de Email (para recuperação de senha, notificações)
